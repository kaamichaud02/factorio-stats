RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=

# Optionnel — nécessaire seulement pour le panneau de chat en jeu
# (alimenté par le broker MQTT du stack log-shipper). Laisse vide pour
# désactiver le panneau de chat. MQTT_HOST doit pointer vers l'IP/nom du
# serveur Factorio où tourne mosquitto (voir log-shipper/).
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=factorio/chat

# Optionnel — notifications Telegram (recherche terminée, fusée lancée,
# join/leave, et mort/attaque de biters si scenario-hooks.lua est ajouté).
# Laisse vide pour désactiver.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel — seuil d'alerte électricité (%) publié sur MQTT
# (factorio/alerts/electricity) pour une automatisation Home Assistant.
# 100 = alerte dès que la consommation dépasse la production.
ELECTRICITY_ALERT_MARGIN_PCT=100

# Optionnel — active le bouton "Donner un objet" du dashboard (exécute une
# commande RCON ciblée et validée). Laisse vide pour désactiver
# complètement cette fonctionnalité. Choisis un jeton long et aléatoire
# si tu l'actives (ex: openssl rand -hex 24) — quiconque le connaît peut
# faire apparaître des objets dans l'inventaire d'un joueur en ligne.
ACTION_TOKEN=
ACTION_MAX_COUNT=1000
# Délai minimum (secondes) avant de pouvoir redonner un objet au même
# joueur — 7200 = 2h par défaut.
PLAYER_ACTION_COOLDOWN_SECONDS=7200
